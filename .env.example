BASE_URL=https://ecommerce-storefront-swart.vercel.app
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# Optional: choose a published product with a variant holding at least 3 units.
# When empty, the suite finds an in-stock product through the storefront UI.
TEST_PRODUCT_SLUG=

# TC-26: active coupon eligible for the selected product/customer (quantity 1).
# Expected discount is an independent BDT amount, including any coupon cap.
TEST_COUPON_CODE=
TEST_COUPON_EXPECTED_DISCOUNT=

# Real COD order submission is part of TC-24. Disable it for read-only runs.
# TC-24 is explicitly skipped, never reported as passed, when disabled.
ALLOW_ORDER_CREATION=true
TEST_ADDRESS_LABEL=Automation QA - Do Not Ship
TEST_RECIPIENT_NAME=Automation Test Customer
TEST_RECIPIENT_PHONE=01700000000
TEST_ADDRESS_AREA=Dhaka
TEST_ADDRESS_LINE=AUTOMATION TEST ONLY - DO NOT SHIP OR FULFIL

# Optional: chrome or msedge. Empty uses Playwright's bundled Chromium.
TEST_BROWSER_CHANNEL=
